{
  "version": 1,
  "build": {
    "build_pack": "dockerfile",
    "engine": "dockerfile",
    "docker_buildkit": false,
    "buildkit": false,
    "use_helper": false,
    "helper_disabled": true,
    "disable_buildx": true,
    "buildx_disabled": true,
    "prepare_builder_image": false,
    "skip_prepare_builder": true,
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "deploy": {
    "network_mode": "bridge",
    "ports": [
      {
        "container": 3000,
        "type": "http"
      }
    ],
    "expose": 3000,
    "healthcheck": {
      "test": ["CMD-SHELL", "exit 0"],
      "interval": 120000000000,
      "timeout": 10000000000,
      "retries": 3,
      "start_period": 30000000000
    },
    "environment": {
      "NODE_ENV": "production",
      "PORT": "3000",
      "HOSTNAME": "0.0.0.0"
    }
  }
}
