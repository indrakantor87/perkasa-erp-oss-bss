{
  "version": 1,
  "build": {
    "build_pack": "dockerfile",
    "engine": "dockerfile",
    "docker_buildkit": true,
    "buildkit": true,
    "use_helper": false,
    "helper_disabled": true,
    "disable_buildx": true,
    "buildx_disabled": true,
    "prepare_builder_image": false,
    "skip_prepare_builder": true,
    "disable_helper": true,
    "dockerfile": "Dockerfile",
    "context": ".",
    "custom_build_command": ".coolify/build.sh",
    "force_recreate": true
  },
  "deploy": {
    "network_mode": "bridge",
    "ports": [
      {
        "container": 3000,
        "type": "http"
      }
    ],
    "expose": 3000,
    "healthcheck": {
      "test": ["CMD", "node", "healthcheck.js"],
      "interval": 60000000000,
      "timeout": 10000000000,
      "retries": 5,
      "start_period": 180000000000
    },
    "environment": {
      "NODE_ENV": "production",
      "PORT": "3000",
      "HOSTNAME": "0.0.0.0"
    },
    "restart": "unless-stopped"
  }
}
