APP_DATA_MODE=review-db
# Untuk memaksa bootstrap mock saat development tanpa DB, ubah ke:
# APP_DATA_MODE=mock

# Wajib diisi pada hosting production agar cookie session tidak memakai secret default development.
AUTH_SESSION_SECRET=

# URL database review MySQL/XAMPP.
# Contoh XAMPP default:
# DATABASE_URL=mysql://root:@127.0.0.1:3306/perkasa_review
DATABASE_URL=

# Timeout koneksi review DB dalam milidetik agar fallback tetap cepat saat MySQL review belum aktif.
REVIEW_DB_CONNECT_TIMEOUT_MS=1500

# Opsional untuk review lokal terkontrol. Jangan isi pada production.
# Format JSON: {"admin.perkasa":"password-kuat","support.ops":"password-kuat"}
BOOTSTRAP_MOCK_AUTH_CREDENTIALS=

# =========================================================================
# Routing engine (untuk jarak perjalanan mengikuti jalan / road distance)
# Jika tidak dikonfigurasi, sistem otomatis fallback ke jarak garis lurus
# (Haversine) dengan status FALLBACK_STRAIGHT_LINE.
# =========================================================================

# Pilihan provider routing yang saat ini diimplementasikan abstraction:
# - osrm                  → OSRM (Open Source Routing Machine) endpoint publik
#                           atau self-hosted. API resmi: /route/v1/{profile}/{coords}
# - self_hosted_osrm      → Alias OSRM untuk instalasi internal/pribadi.
#
# (Provider graphhopper, mapbox, google saat ini masih evaluation;
# abstraction disiapkan, implementasi akan ditambahkan setelah audit
# coverage Indonesia, rate limit, dan biaya di luar fase ini.)
ROUTING_PROVIDER=

# Base URL provider (tanpa trailing slash).
# Contoh self-hosted OSRM default:
# ROUTING_PROVIDER_URL=http://127.0.0.1:5000
ROUTING_PROVIDER_URL=

# API Key (jika provider memerlukan). Dikirim dari server-side (proxy),
# TIDAK pernah di-expose ke browser client.
ROUTING_API_KEY=

# Profile routing default: driving (kendaraan roda 4, default untuk
# kebutuhan sales/marketing di lapangan), walking (jalan kaki),
# atau cycling (sepeda).
ROUTING_DEFAULT_PROFILE=driving

# Timeout request routing dalam milidetik. Jika provider lambat atau
# tidak tersedia dalam batas ini → sistem fallback ke garis lurus.
ROUTING_TIMEOUT_MS=8000
