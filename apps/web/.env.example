APP_DATA_MODE=mock
# Ganti ke review-db saat connector database review sudah siap.
# APP_DATA_MODE=review-db

# URL database review MySQL/XAMPP. Tetap kosong selama service layer masih fallback ke mock.
DATABASE_URL=

# Timeout koneksi review DB dalam milidetik agar fallback tetap cepat saat MySQL review belum aktif.
REVIEW_DB_CONNECT_TIMEOUT_MS=1500
