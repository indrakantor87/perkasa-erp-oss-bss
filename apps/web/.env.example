APP_DATA_MODE=mock
# Saat review DB (XAMPP) siap dipakai, ubah ke:
# APP_DATA_MODE=review-db

# URL database review MySQL/XAMPP.
# Contoh XAMPP default:
# DATABASE_URL=mysql://root:@127.0.0.1:3306/perkasa_review
DATABASE_URL=

# Timeout koneksi review DB dalam milidetik agar fallback tetap cepat saat MySQL review belum aktif.
REVIEW_DB_CONNECT_TIMEOUT_MS=1500
