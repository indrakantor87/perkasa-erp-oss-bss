APP_DATA_MODE=review-db

# Wajib diisi dengan secret acak yang kuat sebelum deploy production.
AUTH_SESSION_SECRET=replace-with-long-random-secret

# Ganti dengan koneksi database target hosting.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/perkasa_review

# Sesuaikan bila koneksi DB production membutuhkan timeout lebih panjang.
REVIEW_DB_CONNECT_TIMEOUT_MS=3000

# Opsional bila process manager tidak mengatur port sendiri.
PORT=3000

# Tetap kosong di production. Bootstrap mock auth harus tetap nonaktif.
BOOTSTRAP_MOCK_AUTH_CREDENTIALS=
