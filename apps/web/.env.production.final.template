# Salin file ini ke `apps/web/.env` di server production.
# Jangan commit file `.env` yang sudah terisi secret nyata.

APP_DATA_MODE=review-db

# Ganti dengan secret acak kuat minimal 32 karakter.
AUTH_SESSION_SECRET=replace-with-strong-random-secret

# Ganti dengan koneksi database production.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/perkasa_review

# Timeout koneksi review DB dalam milidetik.
REVIEW_DB_CONNECT_TIMEOUT_MS=3000

# Port internal aplikasi untuk reverse proxy / PM2.
PORT=3000
